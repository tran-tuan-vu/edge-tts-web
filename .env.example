# Tài khoản dùng chung để đăng nhập (không có đăng ký, chỉ 1 tài khoản)
AUTH_USERNAME=
AUTH_PASSWORD=

# Bí mật để ký JWT phiên đăng nhập. Sinh bằng lệnh:
#   openssl rand -base64 32
AUTH_SECRET=

# API key của FPT.AI Text-to-Speech, dùng cho giọng tiếng Việt (console.fpt.ai).
FPT_AI_API_KEY=

# API key của ElevenLabs, dùng cho giọng tiếng Anh (elevenlabs.io → Profile → API Keys).
ELEVENLABS_API_KEY=
